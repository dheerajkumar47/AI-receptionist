@page "/"
@inherits LiveComponentBase
@using Microsoft.Extensions.Options
@using AiReceptionist.Infrastructure
@inject IEnumerable<IChannelConnector> ChannelConnectors
@inject IIntentEngine Engine
@inject IVoiceSynthesizer Voice
@inject ICalendarProvider Calendar
@inject IEmailSender Email
@inject IOptions<AppOptions> AppOptions

<PageTitle>Dashboard · AI Receptionist</PageTitle>
<h1>Dashboard</h1>

<div class="stats">
    <div class="stat"><span>@_messagesToday</span>messages today</div>
    <div class="stat"><span>@_conversations</span>conversations</div>
    <div class="stat"><span>@_upcoming</span>upcoming appointments</div>
    <a class="stat @(_attention > 0 ? "alert" : "")" href="conversations?attention=true"><span>@_attention</span>need attention</a>
</div>

<div class="grid-2">
    <section class="card">
        <h2>Services</h2>
        <table class="table">
            <tr><td>Language understanding</td><td>@Engine.Name</td><td>@Status(Engine is not KeywordIntentEngine, "offline mode")</td></tr>
            <tr><td>Voice (Azure AI Speech)</td><td></td><td>@Status(Voice.IsConfigured)</td></tr>
            <tr><td>Microsoft 365 calendar</td><td></td><td>@Status(Calendar.IsConfigured)</td></tr>
            <tr><td>Email fallback (SMTP)</td><td>@Email.OwnerAddress</td><td>@Status(Email.IsConfigured)</td></tr>
        </table>
    </section>

    <section class="card">
        <h2>Channels</h2>
        <table class="table">
            @foreach (var c in ChannelConnectors)
            {
                <tr>
                    <td>@Ui.ChannelIcon(c.ChannelId) @c.DisplayName</td>
                    <td class="small">
                        @if (c is IWebhookChannel)
                        {
                            <code>@($"{AppOptions.Value.PublicBaseUrl.TrimEnd('/')}/webhooks/{c.ChannelId}")</code>
                        }
                        else if (c is IPollingChannel p)
                        {
                            <span>polling every @p.PollInterval.TotalSeconds s</span>
                        }
                        else
                        {
                            <span>built-in</span>
                        }
                    </td>
                    <td>@Status(c.IsConfigured)</td>
                </tr>
            }
        </table>
    </section>
</div>

<section class="card">
    <h2>Recent messages</h2>
    <table class="table">
        <thead><tr><th>Time</th><th>Channel</th><th>Contact</th><th></th><th>Message</th><th>Intent</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var m in _recent)
        {
            <tr>
                <td class="nowrap">@Local(m.CreatedUtc)</td>
                <td>@Ui.ChannelIcon(m.Channel)</td>
                <td><a href="conversations/@m.ConversationId">@(m.Conversation.Contact.DisplayName ?? m.Conversation.Contact.ExternalUserId)</a></td>
                <td>@(m.Direction == MessageDirection.Inbound ? "⬅️" : "➡️")@(m.AudioUrl is not null ? " 🔊" : "")</td>
                <td>@Ui.Truncate(m.Text, 90)</td>
                <td>@m.Intent</td>
                <td><span class="@Ui.StatusClass(m.Status)">@m.Status</span></td>
            </tr>
        }
        </tbody>
    </table>
    @if (_recent.Count == 0)
    {
        <p class="muted">No messages yet. Try the <a href="simulator">simulator</a> or send a DM to one of your connected accounts.</p>
    }
</section>

@code {
    private int _messagesToday, _conversations, _upcoming, _attention;
    private List<Message> _recent = new();

    protected override async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var now = DateTime.UtcNow;
        var since = now.AddHours(-24);
        _messagesToday = await db.Messages.CountAsync(m => m.CreatedUtc >= since);
        _conversations = await db.Conversations.CountAsync();
        _upcoming = await db.Appointments.CountAsync(a => a.StartUtc > now && (a.Status == AppointmentStatus.Booked || a.Status == AppointmentStatus.EmailFallback));
        _attention = await db.Conversations.CountAsync(c => c.NeedsAttention);
        _recent = await db.Messages.AsNoTracking().Include(m => m.Conversation).ThenInclude(c => c.Contact)
            .OrderByDescending(m => m.CreatedUtc).ThenByDescending(m => m.Id).Take(20).ToListAsync();
    }

    private static RenderFragment Status(bool ok, string offText = "not configured") =>
        @<span class="@(ok ? "badge ok" : "badge muted")">@(ok ? "active" : offText)</span>;
}
